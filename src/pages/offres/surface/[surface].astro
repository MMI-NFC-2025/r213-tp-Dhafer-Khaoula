---
import "../../../styles/global.css";
import Layout from "../../../layouts/Layout.astro";
import { getOffresBySurface } from "../../../js/backend.mjs";
import Card from "../../../components/Card.astro";

const { surface } = Astro.params;

if (!surface) {
    return Astro.redirect('/offres');
}

const minSurface = parseInt(surface, 10);
const offres = await getOffresBySurface(minSurface);
---

<Layout titre={`Maisons de plus de ${minSurface} m²`}>
    <div class="mb-6">
        <a
            href="/offres"
            class="inline-block text-fuchsia-950 hover:text-fuchsia-700 font-medium"
        >
            ← Retour aux offres
        </a>
    </div>

    <h1 class="text-fuchsia-950 text-5xl mb-4">
        Maisons de plus de {minSurface} m²
    </h1>
    <p class="text-gray-600 mb-8">
        {offres.length} maison{offres.length > 1 ? "s" : ""} trouvée{
            offres.length > 1 ? "s" : ""
        }
    </p>

    {
        offres.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {offres.map((offre) => (
                    <Card offre={offre} />
                ))}
            </div>
        ) : (
            <p class="text-center text-gray-500 py-12">
                Aucune maison trouvée avec cette surface minimum.
            </p>
        )
    }
</Layout>
