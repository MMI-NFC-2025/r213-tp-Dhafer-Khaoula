---
import "../../../styles/global.css";
import Layout from "../../../layouts/Layout.astro";
import { getOffresByPrix } from "../../../js/backend.mjs";
import Card from "../../../components/Card.astro";

const { prix } = Astro.params;
const maxPrix = parseInt(prix);
const offres = await getOffresByPrix(maxPrix);
---

<Layout titre={`Maisons à moins de ${maxPrix.toLocaleString("fr-FR")} €`}>
    <div class="mb-6">
        <a
            href="/offres"
            class="inline-block text-fuchsia-950 hover:text-fuchsia-700 font-medium"
        >
            ← Retour aux offres
        </a>
    </div>

    <h1 class="text-fuchsia-950 text-5xl mb-4">
        Maisons à moins de {maxPrix.toLocaleString("fr-FR")} €
    </h1>
    <p class="text-gray-600 mb-8">
        {offres.length} maison{offres.length > 1 ? "s" : ""} trouvée{
            offres.length > 1 ? "s" : ""
        }
    </p>

    {
        offres.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {offres.map((offre) => (
                    <Card offre={offre} />
                ))}
            </div>
        ) : (
            <p class="text-center text-gray-500 py-12">
                Aucune maison trouvée avec ce prix maximum.
            </p>
        )
    }
</Layout>
