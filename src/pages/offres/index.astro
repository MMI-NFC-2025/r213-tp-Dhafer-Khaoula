---
import Layout from "../../layouts/Layout.astro";
import { getOffres, filterByPrix } from "../../js/backend.mjs";
import Card from "../../components/Card.astro";

let offres;
let message = "";

if (Astro.request.method === "POST") {
	const data = await Astro.request.formData();
	const minPrix = parseInt(data.get("minPrix"));
	const maxPrix = parseInt(data.get("maxPrix"));

	if (minPrix > 0 && maxPrix > 0 && maxPrix > minPrix) {
		offres = await filterByPrix(minPrix, maxPrix);
		if (offres.length === 0) {
			message = `Pas d'offres entre ${minPrix}€ et ${maxPrix}€`;
		} else {
			message = `Liste des offres entre ${minPrix}€ et ${maxPrix}€`;
		}
	} else {
		message = "Veuillez entrer des valeurs valides pour le prix.";
		offres = await getOffres();
	}
} else {
	offres = await getOffres();
}

let categories = ['Tout', ... new Set(offres.map(ev => ev.categorie))];
if(Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const selectedCategory = formData.get("categorie");
    console.log(selectedCategory);
    if(selectedCategory && selectedCategory !== "Tout") {
        offres = offres.filter(ev => ev.categorie === selectedCategory);
        categories = [selectedCategory, ...categories.filter(cat => cat !== selectedCategory)];
    }
}
---

<Layout titre="Offres">
	<h1 class="text-fuchsia-950 text-5xl mb-6">Offres</h1>

	{message && <p class="text-blue-600 mb-4">{message}</p>}

	<form action="/offres" method="POST">
		<input type="number" name="minPrix" placeholder="Prix minimum" />
		<input type="number" name="maxPrix" placeholder="Prix maximum" />
		<input type="submit" value="Filtrer par prix" />
	</form>

	<div class="mb-8 flex gap-4">
		<a
			href="/offres/add"
			class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition-colors"
		>
			+ Ajouter une offre
		</a>
		<a
			href="/offres/surface/80"
			class="bg-fuchsia-950 text-white px-4 py-2 rounded hover:bg-fuchsia-800 transition-colors"
		>
			Maisons &lt; 80 m²
		</a>
		
		<a
			href="/offres/prix/300000"
			class="bg-fuchsia-950 text-white px-4 py-2 rounded hover:bg-fuchsia-800 transition-colors"
		>
			Maisons &lt; 300 000 €
		</a>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		{offres.map((offre) => <Card offre={offre} />)}
	</div>
</Layout>
