---
import Layout from "../../layouts/Layout.astro";
import { getOffres } from "../../js/backend.mjs";
import Card from "../../components/Card.astro";

const offres = await getOffres();
---

<Layout titre="Offres">
	<h1 class="text-fuchsia-950 text-5xl mb-6">Offres</h1>

	<div class="mb-8 flex gap-4">
		<a 
			href="/offres/surface/80"
			class="bg-fuchsia-950 text-white px-4 py-2 rounded hover:bg-fuchsia-800 transition-colors"
		>
			Maisons > 80 m²
		</a>
		<a 
			href="/offres/prix/300000"
			class="bg-fuchsia-950 text-white px-4 py-2 rounded hover:bg-fuchsia-800 transition-colors"
		>
			Maisons &lt; 300 000 €
		</a>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		{offres.map((offre) => <Card offre={offre} />)}
	</div>
</Layout>
